# Copy to .env and fill in your free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: free key from https://serpapi.com for real Google Hotels prices
# (limited free searches per month; without it, hotel prices are estimates).
SERPAPI_API_KEY=

# --- Website (only needed for the web app, not the CLI) ---
# Supabase project -> Project Settings -> API Keys. The secret key must never
# be shared or committed; the publishable key is safe for browsers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated emails that can open /admin (testers' plans and feedback).
ADMIN_EMAILS=

# Free-tier guards (defaults shown).
# PLANS_PER_USER_PER_DAY=3
# PLANS_PER_DAY_TOTAL=8
# MESSAGES_PER_USER_PER_DAY=20
